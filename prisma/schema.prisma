// Prisma schema for Miracle Feng Shui
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  COD_PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLATION_REQUESTED
  CANCELLATION_APPROVED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  /// Null for accounts made with Google sign-in, which have no password.
  passwordHash String?
  /// Google's account id ("sub"), set once the customer signs in with Google.
  googleId     String?    @unique
  /// Set when an admin deactivates the account: it can't sign in and open sessions end. Null means active.
  deactivatedAt DateTime?
  /// Every sign-in carries this number. Raising it signs out every session that holds an older one.
  sessionVersion Int      @default(0)
  role         Role       @default(CUSTOMER)
  phone        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses        Address[]
  orders           Order[]
  checkoutSessions CheckoutSession[]
  reviews          Review[]
  cart             Cart?
  favorites        Favorite[]
  orderStatusChanges OrderStatusEvent[]
  orderArchiveChanges OrderArchiveEvent[]
  reviewModerations   ReviewEvent[]
  notifications       Notification[]
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  @@index([email])
  @@index([resetToken])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  type      String   @default("Home")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  image       String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

model Product {
  id                    String      @id @default(cuid())
  title                 String
  slug                  String      @unique
  description           String
  price                 Float
  comparePrice          Float?
  discount              String?
  images                String[]
  stock                 Int         @default(50)
  categoryId            String
  category              Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags                  String[]
  maker                 String      @default("Miracle Feng Shui Studio")
  makerAvatar           String?
  makerSales            Int         @default(0)
  starSeller            Boolean     @default(false)
  bestseller            Boolean     @default(false)
  etsyPick              Boolean     @default(false)
  freeShipping          Boolean     @default(true)
  itemDetails           String[]
  materials             String[]
  variations            Json?
  allowsPersonalization Boolean     @default(false)
  personalizationPrompt String?
  inDemandCount         Int         @default(0)
  isFeatured            Boolean     @default(false)
  showStockLeft         Boolean     @default(false)
  isActive              Boolean     @default(true)
  /// Visible in the store but can't be bought, e.g. while it can't be made. Stock is kept.
  isPaused              Boolean     @default(false)
  ratingAvg             Float       @default(0.0)
  ratingCount           Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  favorites             Favorite[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([slug])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id                  String   @id @default(cuid())
  cartId              String
  cart                Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity            Int      @default(1)
  selectedVariations  Json?
  personalizationText String?
  isGift              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  /** Unguessable lookup token that the customer-facing order APIs accept. The friendly orderNumber is for display only. */
  accessToken       String?       @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod @default(RAZORPAY)
  paymentStatus     PaymentStatus @default(PENDING)
  total             Float
  shippingAddress   Json
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  courier           String?
  trackingNumber    String?
  cancellationReason      String?
  cancellationRequestedAt DateTime?
  refundRequestedAt       DateTime?
  /// Whether the store allowed cancellation when this order was bought. Changing the store setting later doesn't touch it.
  cancellationAllowed     Boolean       @default(true)
  /// When the order was marked Delivered; cleared if it's moved back. Reviews written after it are verified purchases.
  deliveredAt             DateTime?
  /// Set when an admin archives the finished order: it leaves the admin Orders list for the Archive page.
  /// Customers, invoices and revenue figures are unaffected. Null means not archived.
  archivedAt              DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items             OrderItem[]
  refunds           Refund[]
  statusEvents      OrderStatusEvent[]
  archiveEvents     OrderArchiveEvent[]

  @@index([userId])
  @@index([status])
  @@index([archivedAt])
  @@index([orderNumber])
}

enum OrderEventActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

/// One row per change to an order's status, written in the same step as the change. Never edited.
model OrderStatusEvent {
  id          String          @id @default(cuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Null for the first event, when the order is created.
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actor       OrderEventActor
  /// The admin or customer who made the change; kept as null if that account is ever removed.
  changedById String?
  changedBy   User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime        @default(now())

  @@index([orderId, createdAt])
}

/// One row each time an admin archives or restores an order. Never edited. Shown in the admin order history only.
model OrderArchiveEvent {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// True for archived, false for restored.
  archived    Boolean
  /// Kept as null if that admin account is ever removed.
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
}

/// What a customer is paying for. It becomes an Order only once the payment is confirmed.
model CheckoutSession {
  id              String   @id @default(cuid())
  razorpayOrderId String   @unique
  orderNumber     String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  total           Float
  shippingAddress Json
  items           Json
  /// The store's cancellation setting the customer saw at checkout.
  cancellationAllowed Boolean @default(true)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED
}

model Refund {
  id               String       @id @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  razorpayRefundId String?      @unique
  amountPaise      Int
  status           RefundStatus @default(REQUESTED)
  failureReason    String?
  stockReturned    Boolean      @default(false)
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  title               String
  price               Float
  quantity            Int
  image               String
  selectedVariations  Json?
  personalizationText String?
  createdAt           DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Review {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating           Int
  comment          String
  productVariation String?
  /// Set when an admin hides the review: it leaves the store and the Reviews page for the Archive. Null means shown.
  hiddenAt         DateTime?
  hiddenReason     ReviewHideReason?
  hiddenNote       String?
  /// The author's request to look again at a hidden review: one per take-down, cleared when it's hidden again or restored.
  appealMessage    String?
  appealedAt       DateTime?
  /// The admin's answer when the review stays hidden. Shown to the author.
  appealResponse   String?
  appealResolvedAt DateTime?
  /// The store's public reply, shown under the review.
  reply            String?
  repliedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  events           ReviewEvent[]

  @@unique([userId, productId])
  @@index([productId, hiddenAt])
  @@index([userId])
}

/// Why a review was hidden. About what it says, never how many stars it gave.
enum ReviewHideReason {
  ABUSIVE
  SPAM
  PERSONAL_DETAILS
  OFF_TOPIC
  NOT_GENUINE
  OTHER
}

enum ReviewEventAction {
  HIDDEN
  RESTORED
  REPLIED
  REPLY_REMOVED
  APPEALED
  APPEAL_DECLINED
}

/// One row per admin action on a review. Never edited.
model ReviewEvent {
  id          String            @id @default(cuid())
  reviewId    String
  review      Review            @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  action      ReviewEventAction
  reason      ReviewHideReason?
  note        String?
  /// Kept as null if that admin account is ever removed.
  changedById String?
  changedBy   User?             @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([reviewId, createdAt])
}

/// Store-wide settings, kept in a single row (id 1).
model StoreSettings {
  id                  Int      @id @default(1)
  /// Whether customers can cancel orders. Each order records the value it was bought under.
  cancellationAllowed Boolean  @default(true)
  updatedById         String?
  updatedAt           DateTime @updatedAt
}

/// What a notification is about. Picks its icon; add a value for each new kind of alert.
enum NotificationKind {
  ORDER
  REFUND
  REVIEW
}

/// An in-app message to a customer, shown in the Notifications drawer. Clearing deletes it.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  /// Where tapping it goes, such as the order list or a product. Null when there's nowhere to go.
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}
