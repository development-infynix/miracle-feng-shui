# Database (Prisma uses DATABASE_URL)
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change_me_to_a_long_random_secret"

# Google sign-in (optional; the "Continue with Google" button only shows when both are set).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments (placeholder/test)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# S3 / Tigris object storage
S3_ENDPOINT="https://t3.storage.dev"
S3_REGION="auto"
S3_ACCESS_KEY_ID="tid_..."
S3_SECRET_ACCESS_KEY="tsec_..."
S3_BUCKET="your-bucket-name"
S3_PUBLIC_URL="https://your-bucket.t3.storage.dev"

# Seller details printed on invoices. Leave a value empty and that line is left off the invoice.
# Use your real registration details only.
NEXT_PUBLIC_SELLER_BRAND_NAME="Miracle feng shui"
NEXT_PUBLIC_SELLER_LEGAL_NAME=""
NEXT_PUBLIC_SELLER_ADDRESS=""
NEXT_PUBLIC_SELLER_CITY=""
NEXT_PUBLIC_SELLER_PINCODE=""
# State decides CGST+SGST (same state as the buyer) vs IGST. Example: "Kerala" with code "32".
NEXT_PUBLIC_SELLER_STATE=""
NEXT_PUBLIC_SELLER_STATE_CODE=""
NEXT_PUBLIC_SELLER_EMAIL=""
NEXT_PUBLIC_SELLER_PHONE=""
NEXT_PUBLIC_SELLER_GSTIN=""
NEXT_PUBLIC_SELLER_PAN=""
# Letter of Undertaking, only if you export without paying IGST.
NEXT_PUBLIC_SELLER_LUT=""
# UAE invoices (VAT 5%): only if you're VAT-registered in the UAE.
NEXT_PUBLIC_SELLER_UAE_TRN=""
NEXT_PUBLIC_SELLER_UAE_ADDRESS=""
